{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext", // ✅ Outputs native ESM import/export
    "moduleResolution": "Bundler", // Modern ESM-compatible resolution
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}