# Next.js loads this package's .env (an existing .env.local takes precedence).
# Fill in your own Clerk development keys to sign in; never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AI_PIPELINE_URL=http://127.0.0.1:5000
# Replace with the same random value in ai-pipeline/.env.
AI_PIPELINE_TOKEN=replace-with-a-shared-random-token
# Match these limits in the Next.js and Flask environments.
QUESTION_PAPER_MAX_FILE_BYTES=26214400
QUESTION_PAPER_MAX_FILE_COUNT=20
QUESTION_PAPER_MAX_REQUEST_BYTES=209715200

# Backend services execute inside Next.js and need these values here too.
# Backend CLI tools load .env from their working directory.
# Next.js imports backend code in its own process: also configure frontend/.env.
mongodb_url=mongodb://127.0.0.1:27017/eesa
# Required only for Gemini analysis/evaluation. Prefer the lowercase name used by all services.
gemini_api_key=
GEMINI_API_KEY=
# Optional legacy values used for secret redaction.
user_email=
user_password=
# AWS credential chain: leave blank to use your AWS profile / IAM role.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=replace-with-your-bucket
S3_BACKUP_BUCKET=
# Legacy credential aliases for comparePdfDirectVsOcr.js only.
awsaccessKeyId=
awssecretAccessKey=
awsSessionToken=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
OCR_PIPELINE_URL=http://127.0.0.1:5000
EC2_OCR_URL=http://127.0.0.1:5000
OCR_TOTAL_TIMEOUT_MS=120000
OCR_REQUEST_TIMEOUT_MS=60000
OCR_SUBMIT_TIMEOUT_MS=120000
OCR_POLL_INTERVAL_MS=2000
OCR_MAX_STATUS_ATTEMPTS=60
