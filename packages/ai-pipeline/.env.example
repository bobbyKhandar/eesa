# Loaded at startup by src/aws_region.py without overriding exported variables.
# Replace with the same random value in frontend/.env.
AI_PIPELINE_TOKEN=replace-with-a-shared-random-token
AWS_REGION=ap-south-1
# Optional region aliases; AWS_REGION wins when nonempty.
AWS_DEFAULT_REGION=
aws_location=
# Leave credentials blank for AWS profiles/IAM roles; fill in only for AWS features.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Avoid EC2 metadata probes on a local PC; unset when using an EC2 instance role.
AWS_EC2_METADATA_DISABLED=true
# Legacy credential aliases used by the PDF comparison utility.
awsaccessKeyId=
awssecretAccessKey=
awsSessionToken=
S3_BUCKET=replace-with-your-bucket
SNS_TOPIC_ARN=
SNS_ROLE_ARN=
BEDROCK_MODEL_ID=google.gemma-3-27b-it
MAX_CONCURRENT_JOBS=3
JOB_METADATA_CACHE_TTL=5.0
LANCEDB_PATH=./lancedb_data
# Gunicorn only; the dev entry point binds to 127.0.0.1:5000.
AI_PIPELINE_BIND=127.0.0.1:5000
AI_PIPELINE_TRUSTED_HOSTS=
AI_PIPELINE_ALLOW_REMOTE=0
AI_PIPELINE_ALLOW_PUBLIC_BIND=0
DEFAULT_DPI=400
MAX_PAGES_PER_PDF=1000
MAX_PDF_PAGE_PIXELS=50000000
# Match these limits in the Next.js and Flask environments.
QUESTION_PAPER_MAX_FILE_BYTES=26214400
QUESTION_PAPER_MAX_FILE_COUNT=20
QUESTION_PAPER_MAX_REQUEST_BYTES=209715200
# Opt-in live AWS integration tests (off by default).
USE_REAL_AWS=false
