{
  "name": "eesa",
  "private": true,
  "workspaces": ["packages/backend", "packages/frontend"],
  "overrides": {
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "test": "node --experimental-strip-types --import ./tests/node/register-hook.mjs --test tests/node/exam-evaluator-security.test.ts",
    "test:auth-dashboard": "node --experimental-strip-types --test tests/node/dashboard-auth.test.ts",
    "test:exams-crud": "node --experimental-strip-types --test tests/node/exams-crud.test.ts tests/node/admin-exams.test.ts",
    "test:node": "node --experimental-strip-types --import ./tests/node/register-hook.mjs --test \"tests/node/*.test.ts\"",
    "test:submissions": "node --experimental-strip-types --test tests/node/submission-results.test.ts",
    "test:admin-users-resources": "node --experimental-strip-types --test tests/node/admin-users-resources.test.ts tests/node/admin-user-list.test.ts",
    "test:admin-database-jobs": "node --experimental-strip-types --test tests/node/admin-database-jobs.test.ts",
    "test:ai": "node --test --experimental-strip-types tests/node/backend/*.test.ts tests/node/frontend/*.test.ts",
    "test:python": "python3 -m pytest tests/python"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.14",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
